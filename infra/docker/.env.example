# Copy to infra/docker/.env and adjust as needed.
POSTGRES_USER=procintel
POSTGRES_PASSWORD=procintel
POSTGRES_DB=procintel
POSTGRES_PORT=5432

# Local Keycloak identity provider.
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=procintel-admin-change-me
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-local
PROCINTEL_WEB_ORIGIN=http://localhost:3000
PROCINTEL_WEB_ORIGIN_ALT=http://127.0.0.1:3000
PROCINTEL_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000101

# Used by db/run_migrations.sh and by the ingestion connectors/tests.
# With the defaults above and docker-compose port-forwarded to the host:
DATABASE_URL=postgresql://procintel:procintel@localhost:5432/procintel

# Optional override; defaults to the official ΚΗΜΔΗΣ production API.
KHMDHS_API_BASE_URL=

# Required only if running the ΚΗΜΔΗΣ CLI with --with-diavgeia. Same
# discipline as above — description.txt gives even less detail for
# Διαύγεια's API than it does for ΚΗΜΔΗΣ. Confirm before setting.
DIAVGEIA_API_BASE_URL=

# ΓΕΜΗ production use needs a personal API key. The base URL already defaults
# to the published Open Data v1 endpoint and only needs overriding for a proxy.
GEMI_API_BASE_URL=
GEMI_API_KEY=

# Required only if running the ΚΗΜΔΗΣ CLI with --with-anaptyxi. §19.3
# requires a separate source adapter per programming period — each is very
# likely a different deployment/hostname, so each gets its own var.
# ANAPTYXI_API_BASE_URL (no suffix) is a backward-compatible alias for the
# 2014-2020 var below. --anaptyxi-period selects which one is read;
# defaults to 2014-2020 (best-documented of the three per description.txt).
ANAPTYXI_API_BASE_URL=
ANAPTYXI_2007_2013_API_BASE_URL=
ANAPTYXI_2014_2020_API_BASE_URL=
ANAPTYXI_2021_2027_API_BASE_URL=

# Optional override; TED Search API v3 defaults to api.ted.europa.eu and
# requires no authentication.
TED_API_BASE_URL=
TED_RATE_LIMIT_PER_MINUTE=60
TED_BENCHMARK_COUNTRIES=AT,BE,BG,HR,CY,CZ,DE,DK,EE,ES,FI,FR,GR,HU,IE,IT,LT,LU,LV,MT,NL,PL,PT,RO,SE,SI,SK
TED_COUNTRIES_PER_CYCLE=5
TED_DAILY_LOOKBACK_DAYS=9
TED_BENCHMARK_LOOKBACK_DAYS=365

# Required only if running the TED CLI with --with-vies.
VIES_API_BASE_URL=

# Optional override; ΜΕΦ defaults to its published public API.
MEF_API_BASE_URL=

# Required to run the CKAN connector (services/ingestion/connectors/ckan/cli.py).
# data.gov.gr is CKAN-based (full production since May 2026) — the Action
# API paths (package_search/package_show/resource_search) are standard CKAN,
# but the base hostname and exact limits still need confirming against the
# live deployment.
CKAN_API_BASE_URL=

# Optional fine-grained place-of-performance geocoder. Leave unset to use
# locally loaded administrative boundaries only. For historical/bulk work use
# a self-hosted or contracted Nominatim-compatible endpoint. The public OSMF
# endpoint is explicitly opt-in and clamped by the worker to 4 requests/min.
GEO_GEOCODER_BASE_URL=
GEO_GEOCODER_USER_AGENT=
GEO_GEOCODER_PROVIDER=NOMINATIM
GEO_GEOCODER_RATE_LIMIT_PER_MINUTE=60
GEO_GEOCODER_TIMEOUT_SECONDS=20

# Required to run services/search_index (OpenSearch full-text indexing +
# /v1/search/fulltext). With docker-compose's opensearch service and its
# default port mapping:
OPENSEARCH_URL=http://localhost:9200

# Local Keycloak realm imported by docker compose.
OIDC_ISSUER_URL=http://localhost:8080/realms/procintel
OIDC_AUDIENCE=procintel-api
OIDC_CLIENT_ID=procintel-web
OIDC_REDIRECT_URI=http://localhost:3000/callback

# Required only to use services/documents/clamav.py::ClamdAntivirusScanner
# (a real antivirus scanner) instead of the default no-op stub. Set either
# CLAMD_HOST (+ optional CLAMD_PORT, default 3310) for a TCP clamd, or
# CLAMD_SOCKET_PATH for a Unix socket one.
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_SOCKET_PATH=

# SMTP is required only for real EMAIL alert delivery
# (services/alerts/email_delivery.py) — LogDeliveryChannel/WEBHOOK/TEAMS/
# SLACK don't need it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=alerts@procintel.example
