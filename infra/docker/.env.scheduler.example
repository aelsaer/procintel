# Daily wall-clock schedule. The runner rechecks a short overlap to catch
# late source updates; canonical writes remain idempotent.
DAILY_INGEST_AT=02:30
DAILY_INGEST_TIMEZONE=Europe/Athens
DAILY_INGEST_LOOKBACK_DAYS=3
DAILY_INGEST_MIN_INTERVAL_HOURS=23
DAILY_GEOSPATIAL_MAX_JOBS=12000
DAILY_SCORING_LOOKBACK_DAYS=120
SCHEDULER_OPENSEARCH_URL=http://opensearch:9200
DAILY_DIAVGEIA_MAX_LOOKUPS=1000
DAILY_GEMI_MAX_LOOKUPS=500
DAILY_MEF_MAX_LOOKUPS=500
DAILY_ANAPTYXI_MAX_LOOKUPS_PER_PERIOD=500
DAILY_VIES_MAX_LOOKUPS=500
# Work budgets are above the observed daily intake. Provider token buckets
# below remain the hard request-rate limits.
DAILY_DOCUMENT_MAX_DOWNLOADS=10000
DAILY_ADAMCHAIN_MAX_LOOKUPS=12000
DAILY_ENRICHMENT_MAX_JOBS=30000

# Primary source limits. Keep these at or below the provider allowance.
KHMDHS_RATE_LIMIT_PER_MINUTE=180
TED_RATE_LIMIT_PER_MINUTE=60
TED_BENCHMARK_COUNTRIES=AT,BE,BG,HR,CY,CZ,DE,DK,EE,ES,FI,FR,GR,HU,IE,IT,LT,LU,LV,MT,NL,PL,PT,RO,SE,SI,SK
TED_COUNTRIES_PER_CYCLE=5
TED_DAILY_LOOKBACK_DAYS=9
TED_BENCHMARK_LOOKBACK_DAYS=365
DIAVGEIA_RATE_LIMIT_PER_MINUTE=60
MEF_RATE_LIMIT_PER_MINUTE=60
MEF_MAX_RETRY_ATTEMPTS=2
MEF_REQUEST_TIMEOUT_SECONDS=10
CKAN_API_BASE_URL=
CKAN_RATE_LIMIT_PER_MINUTE=60
INSPIRE_KTIMATOLOGIO_WMS_URL=https://gis.ktimanet.gr/inspire/rest/services/cadastralparcels/CadastralParcelWMS/MapServer/exts/InspireView/service
INSPIRE_GREECE_NUTS_URL=https://gisco-services.ec.europa.eu/distribution/v2/nuts/geojson/NUTS_RG_03M_2024_4326.geojson
INSPIRE_GREECE_POSTAL_NUTS_URL=https://gisco-services.ec.europa.eu/tercet/NUTS-2024/pc2025_EL_NUTS-2024_v1.0.zip

# ΓΕΜΗ is inactive until a real Open Data API key is supplied.
GEMI_API_KEY=
GEMI_RATE_LIMIT_PER_MINUTE=60

# Each ΑΝΑΠΤΥΞΗ programming period is a separate deployment. Leave an
# unconfirmed endpoint blank; the runner reports it as inactive.
ANAPTYXI_2007_2013_API_BASE_URL=
ANAPTYXI_2014_2020_API_BASE_URL=
ANAPTYXI_2021_2027_API_BASE_URL=
ANAPTYXI_RATE_LIMIT_PER_MINUTE=60

# VIES is only called for non-Greek suppliers discovered through TED.
VIES_API_BASE_URL=https://ec.europa.eu/taxation_customs/vies/services
VIES_RATE_LIMIT_PER_MINUTE=60

# Optional Nominatim-compatible geocoder. Without this, local Greek
# boundaries and the loaded place gazetteer are still used.
GEO_GEOCODER_BASE_URL=
GEO_GEOCODER_USER_AGENT=
GEO_GEOCODER_RATE_LIMIT_PER_MINUTE=60
